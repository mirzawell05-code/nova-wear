generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductBadge {
  NEW
  HIT
  SALE
  NONE
}

enum OrderStatus {
  NEW
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DeliveryMethod {
  COURIER
  PICKUP
}

enum PaymentMethod {
  CASH_ON_DELIVERY
}

model Admin {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  failedLogins Int @default(0)
  lockedUntil DateTime?
  createdAt    DateTime @default(now())
  sessions     Session[]
}

model Session {
  id        String @id @default(cuid())
  tokenHash String @unique
  adminId   String
  admin     Admin @relation(fields:[adminId], references:[id], onDelete:Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([adminId])
}

model Category {
  id        String @id @default(cuid())
  name      String
  slug      String @unique
  order     Int @default(0)
  products  Product[]
}

model Product {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String @db.Text
  fabric      String
  gender      String // men | women | unisex
  categoryId  String
  category    Category @relation(fields:[categoryId], references:[id], onDelete:Restrict)
  price       Int // minor-free integer KGS
  oldPrice    Int?
  badge       ProductBadge @default(NONE)
  isActive    Boolean @default(true)
  featured    Boolean @default(false)
  popularity  Int @default(0)
  images      ProductImage[]
  variants    ProductVariant[]
  items       OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([isActive, createdAt])
  @@index([categoryId, isActive])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  product   Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  url       String
  sort      Int @default(0)
  @@index([productId, sort])
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String
  product   Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  size      String
  color     String
  colorHex  String
  stock     Int @default(0)
  items     OrderItem[]
  @@unique([productId, size, color])
  @@index([productId])
}

model Order {
  id            String @id @default(cuid())
  number        String @unique
  firstName     String
  lastName      String
  phone         String
  city          String
  address       String
  comment       String?
  delivery      DeliveryMethod
  payment       PaymentMethod
  status        OrderStatus @default(NEW)
  subtotal      Int
  deliveryFee   Int
  total         Int
  items         OrderItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([createdAt])
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  order      Order @relation(fields:[orderId], references:[id], onDelete:Cascade)
  productId  String?
  product    Product? @relation(fields:[productId], references:[id], onDelete:SetNull)
  variantId  String?
  variant    ProductVariant? @relation(fields:[variantId], references:[id], onDelete:SetNull)
  name       String
  size       String
  color      String
  image      String
  unitPrice  Int
  quantity   Int
  lineTotal  Int
}

model Subscriber {
  id        String @id @default(cuid())
  email     String @unique
  createdAt DateTime @default(now())
}
