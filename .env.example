# For local Docker PostgreSQL. Change the password for deployment.
DATABASE_URL="postgresql://nova:nova_local_password@localhost:5432/novawear?schema=public"
# Required for seed: unique admin credentials (do not commit a real password).
ADMIN_EMAIL="admin@nova.local"
ADMIN_PASSWORD="REPLACE_WITH_A_UNIQUE_16_PLUS_CHARACTER_PASSWORD"
# Absolute URL of this website (for metadata and deployment).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Set these before a public launch; blank values hide unconfigured links.
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
